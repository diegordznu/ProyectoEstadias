# Servidor
PORT=3000

# Secreto para firmar las sesiones (JWT). Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# API externa (ERP / base de datos externa)
ERP_API_URL=
ERP_DEVICE_ID=

# Base de datos propia (usuarios del sistema).
# Opción A: cadena completa (requiere el esquema de sql/01_usuarios.sql)
DATABASE_URL=postgresql://usuario:password@localhost:5432/grupoarmas
#
# Opción B: variables individuales (solo se leen si DATABASE_URL está vacío)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=usuario
# PGPASSWORD=password
# PGDATABASE=grupoarmas
