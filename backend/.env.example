# Copiar a backend/.env para desarrollo local.
# En Vercel estas mismas variables se configuran en Project → Settings → Environment Variables.

# Puerto del servidor local (en Vercel no se usa)
PORT=3000

# Secreto para firmar las sesiones (JWT). OBLIGATORIO. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Base de datos (Supabase). OBLIGATORIO.
# Usar el pooler de transacciones (puerto 6543) con el rol de mínimo privilegio
# "app_inventario" (sql/05_rol_app.sql), NO con "postgres". En el pooler el usuario lleva
# el id del proyecto: app_inventario.<proyecto>. Los parámetros ssl* de la cadena se
# ignoran cuando hay DATABASE_CA_CERT.
DATABASE_URL=postgresql://app_inventario.<proyecto>:<password>@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# Certificado raíz de Supabase (PEM) para verificar al servidor de la BD.
# OBLIGATORIO en Vercel (sin él la API no arranca). Se descarga en Supabase:
# Project Settings → Database → SSL Configuration → Download certificate.
# En una sola línea, escribir los saltos como \n; en Vercel se puede pegar tal cual (multilínea).
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Interfaz donde escucha el servidor local. Por defecto solo esta máquina (127.0.0.1):
# las demás computadoras entran por el HTTPS de Vite. Opcional.
# HOST=127.0.0.1

# Zona horaria del negocio para "hoy" (vigencias) y "ahora" (fechas futuras). Opcional.
# APP_TIMEZONE=America/Mexico_City
